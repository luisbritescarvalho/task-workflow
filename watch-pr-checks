#!/usr/bin/env bash

set -uo pipefail

usage() {
  echo "Usage: watch-pr-checks <PR number|URL|branch> [owner/repo] [--retry-once] [--interval SECONDS]" >&2
}

retry_once=0
interval=60
positional=()
while (($#)); do
  case "$1" in
    --retry-once)
      retry_once=1
      shift
      ;;
    --interval)
      if (($# < 2)) || ! [[ "$2" =~ ^[0-9]+$ ]] || (( $2 < 5 )); then
        echo "--interval must be at least 5 seconds." >&2
        exit 2
      fi
      interval="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

if ((${#positional[@]} < 1 || ${#positional[@]} > 2)); then
  usage
  exit 2
fi

target="${positional[0]}"
repo="${positional[1]:-xing-com/crate}"

if ! command -v gh >/dev/null 2>&1; then
  echo "GitHub CLI (gh) is required." >&2
  exit 127
fi

notify() {
  local title="$1"
  local message="$2"
  if command -v osascript >/dev/null 2>&1; then
    osascript - "$title" "$message" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
  fi
}

watch_checks() {
  gh pr checks "$target" --repo "$repo" --watch --fail-fast --interval "$interval"
}

check_details() {
  gh pr checks "$target" --repo "$repo" \
    --json name,state,bucket,link,event,workflow 2>/dev/null || true
}

failed_names() {
  local details="$1"
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$details" | jq -r '[.[] | select(.bucket == "fail" or .bucket == "cancel") | .name] | join(", ")' 2>/dev/null || true
  fi
}

action_run_ids() {
  local details="$1"
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$details" | jq -r '.[] | select(.bucket == "fail" or .bucket == "cancel") | .link // empty' 2>/dev/null \
      | grep -Eo '/actions/runs/[0-9]+' \
      | sed 's#.*/##' \
      | sort -u || true
  else
    printf '%s' "$details" | grep -Eo 'https?://[^" ]*/actions/runs/[0-9]+' \
      | grep -Eo '[0-9]+$' \
      | sort -u || true
  fi
}

rerun_run_ids() {
  local run_ids="$1"
  local rerun_count=0
  local run_id
  while IFS= read -r run_id; do
    [[ -n "$run_id" ]] || continue
    if ! retryable_run "$run_id"; then
      echo "Skipping automatic retry for non-infrastructure run $run_id." >&2
      continue
    fi
    echo "→ Rerun failed GitHub Actions jobs in run $run_id" >&2
    if gh run rerun "$run_id" --failed --repo "$repo" >&2; then
      rerun_count=$((rerun_count + 1))
    else
      echo "Could not rerun GitHub Actions run $run_id; continuing without another retry." >&2
    fi
  done <<< "$run_ids"
  echo "$rerun_count"
}

retryable_run() {
  local run_id="$1"
  command -v jq >/dev/null 2>&1 || return 1
  local run
  run="$(gh run view "$run_id" --repo "$repo" --json event,name,workflowName 2>/dev/null || true)"
  [[ -n "$run" ]] || return 1
  printf '%s' "$run" | jq -e '
    .event == "merge_group" or
    (.event == "workflow_dispatch" and
      ((.workflowName // .name // "") | test("docker|container|runner|cache|setup|infrastructure|merge|queue"; "i")))
  ' >/dev/null 2>&1
}

rerun_failed_actions() {
  local details="$1"
  rerun_run_ids "$(action_run_ids "$details")"
}

pull_request_number() {
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$target"
  elif [[ "$target" =~ /pull/([0-9]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    gh pr view "$target" --repo "$repo" --json number --jq .number 2>/dev/null || true
  fi
}

queue_info() {
  local number="$1"
  local owner="${repo%%/*}"
  local name="${repo#*/}"
  gh api graphql \
    -f query='query($owner:String!,$repo:String!,$number:Int!){repository(owner:$owner,name:$repo){pullRequest(number:$number){state merged isInMergeQueue mergeQueueEntry{state enqueuedAt}}}}' \
    -F owner="$owner" -F repo="$name" -F number="$number" 2>/dev/null || true
}

merge_group_branch() {
  local number="$1"
  local enqueued_at="$2"
  local runs
  runs="$(gh run list --repo "$repo" --event merge_group --limit 100 \
    --json headBranch,createdAt 2>/dev/null || true)"
  [[ -n "$runs" ]] || return 0
  if [[ -n "$enqueued_at" ]]; then
    printf '%s' "$runs" | jq -r --arg pr "$number" --arg enqueued "$enqueued_at" '
      [.[] | select(.headBranch | test("/pr-" + $pr + "-"))
        | select((.createdAt | fromdateiso8601) >= ($enqueued | fromdateiso8601))]
      | sort_by(.createdAt) | last | .headBranch // empty
    ' 2>/dev/null || true
  else
    printf '%s' "$runs" | jq -r --arg pr "$number" '
      [.[] | select(.headBranch | test("/pr-" + $pr + "-"))]
      | sort_by(.createdAt) | last | .headBranch // empty
    ' 2>/dev/null || true
  fi
}

QUEUE_FAILED_IDS=""
QUEUE_FAILED_NAMES=""

watch_merge_queue() {
  local number="$1"
  command -v jq >/dev/null 2>&1 || {
    echo "jq is required to monitor merge-queue checks; skipping queue monitoring." >&2
    return 0
  }

  local branch=""
  local seen_active=0
  local info active enqueued_at runs failed_ids failed_names pending_ids run_id
  while :; do
    info="$(queue_info "$number")"
    if [[ -z "$info" ]]; then
      echo "Could not read merge-queue state; PR checks were still monitored." >&2
      return 0
    fi
    active="$(printf '%s' "$info" | jq -r '.data.repository.pullRequest.isInMergeQueue // false')"
    if [[ "$active" != true ]]; then
      if ((seen_active == 0)); then
        return 0
      fi
      if [[ "$(printf '%s' "$info" | jq -r '.data.repository.pullRequest.merged // false')" == true ]]; then
        return 0
      fi
      echo "Merge queue is no longer active for PR $number." >&2
      return 1
    fi
    seen_active=1

    enqueued_at="$(printf '%s' "$info" | jq -r '.data.repository.pullRequest.mergeQueueEntry.enqueuedAt // empty')"
    if [[ -z "$branch" ]]; then
      branch="$(merge_group_branch "$number" "$enqueued_at")"
    fi
    if [[ -z "$branch" ]]; then
      echo "→ Waiting for the merge-group workflow for PR $number"
      sleep "$interval"
      continue
    fi

    runs="$(gh run list --repo "$repo" --branch "$branch" --limit 100 \
      --json databaseId,name,workflowName,status,conclusion,url 2>/dev/null || true)"
    failed_ids="$(printf '%s' "$runs" | jq -r '
      .[] | select(.status == "completed" and (.conclusion // "") as $c |
        ($c != "success" and $c != "skipped" and $c != "neutral")) | .databaseId
    ' 2>/dev/null || true)"
    if [[ -n "$failed_ids" ]]; then
      failed_names="$(printf '%s' "$runs" | jq -r '
        [.[] | select(.status == "completed" and (.conclusion // "") as $c |
          ($c != "success" and $c != "skipped" and $c != "neutral"))
          | (.workflowName // .name)] | unique | join(", ")
      ' 2>/dev/null || true)"
      QUEUE_FAILED_IDS="$failed_ids"
      QUEUE_FAILED_NAMES="${failed_names:-merge-group checks}"
      return 1
    fi

    pending_ids="$(printf '%s' "$runs" | jq -r '.[] | select(.status != "completed") | .databaseId' 2>/dev/null || true)"
    if [[ -n "$pending_ids" ]]; then
      while IFS= read -r run_id; do
        [[ -n "$run_id" ]] || continue
        gh run watch "$run_id" --repo "$repo" --exit-status || true
      done <<< "$pending_ids"
    else
      echo "→ Merge-group checks are waiting on external or queued statuses"
      sleep "$interval"
    fi
  done
}

watch_checks
status=$?
names=""

if ((status != 0)); then
  details="$(check_details)"
  names="$(failed_names "$details")"
  [[ -n "$names" ]] || names="one or more checks"

  if ((retry_once)); then
    rerun_count="$(rerun_failed_actions "$details" | tail -n 1)"
    if [[ "$rerun_count" =~ ^[1-9][0-9]*$ ]]; then
      notify "PR checks: retrying" "$repo#$target — rerunning failed GitHub Actions once."
      watch_checks
      retry_status=$?
      if ((retry_status == 0)); then
        status=0
      else
        details="$(check_details)"
        names="$(failed_names "$details")"
        [[ -n "$names" ]] || names="one or more checks"
        status=$retry_status
      fi
    else
      echo "No eligible merge-queue/Actions run was found for an automatic retry; deterministic and external failures are left untouched." >&2
    fi
  fi
fi

if ((status == 0)); then
  pr_number="$(pull_request_number)"
  if [[ -n "$pr_number" ]]; then
    echo "→ Checking merge-queue validation for PR $pr_number"
    if ! watch_merge_queue "$pr_number"; then
      status=1
      names="${QUEUE_FAILED_NAMES:-merge-queue checks}"
      if ((retry_once)) && [[ -n "$QUEUE_FAILED_IDS" ]]; then
        rerun_count="$(rerun_run_ids "$QUEUE_FAILED_IDS" | tail -n 1)"
        if [[ "$rerun_count" =~ ^[1-9][0-9]*$ ]]; then
          notify "Merge queue: retrying" "$repo#$pr_number — rerunning eligible failed jobs once."
          if watch_merge_queue "$pr_number"; then
            status=0
          else
            names="${QUEUE_FAILED_NAMES:-merge-queue checks}"
          fi
        fi
      fi
    fi
  fi
fi

if ((status == 0)); then
  notify "PR checks: $repo#$target" "PR and merge-queue checks passed."
  exit 0
fi

notify "PR checks failed: $repo#$target" "$names. Rerun eligible checks or inspect the PR."
echo "Checks failed for $repo#$target: $names" >&2
echo "Inspect: https://github.com/$repo/pull/$target" >&2
exit "$status"
